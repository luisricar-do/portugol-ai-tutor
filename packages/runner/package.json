{
  "name": "@luisricar-do/runner",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisricar-do/portugol-ai-tutor.git"
  },
  "keywords": [
    "portugol",
    "webstudio"
  ],
  "author": "Douglas Gadêlha <dgadelha@live.com>",
  "contributors": [
    "Danilo Gadêlha <dngadelha@outlook.com>"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/luisricar-do/portugol-ai-tutor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/luisricar-do/portugol-ai-tutor#readme",
  "sideEffects": false,
  "main": "lib/entrypoints/node.js",
  "browser": "lib/entrypoints/browser.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "browser": "./lib/entrypoints/browser.js",
      "default": "./lib/entrypoints/node.js"
    },
    "./headless": {
      "types": "./lib/headless/index.d.ts",
      "default": "./lib/headless/index.js"
    },
    "./headless/cli": "./lib/headless/cli.js",
    "./package.json": "./package.json"
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "build:w": "tsc -w",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test:setup": "./tests/setup.sh",
    "pretest": "npm run test:setup",
    "test": "vitest"
  },
  "dependencies": {
    "@luisricar-do/antlr": "*",
    "@luisricar-do/parser": "*",
    "@luisricar-do/runtime": "*",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
