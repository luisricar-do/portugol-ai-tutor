{
  "name": "@luisricar-do/ide",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisricar-do/portugol-ai-tutor.git"
  },
  "keywords": [
    "portugol",
    "webstudio"
  ],
  "author": "Douglas Gadêlha <dgadelha@live.com>",
  "contributors": [
    "Danilo Gadêlha <dngadelha@outlook.com>"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/luisricar-do/portugol-ai-tutor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/luisricar-do/portugol-ai-tutor#readme",
  "scripts": {
    "changelog": "node ../../.github/scripts/changelog.mjs beta src/app/changelog.gerado.md",
    "prestart": "npm run changelog && node scripts/inject-version.mjs",
    "start": "ng serve",
    "prestart:study": "npm run changelog && node scripts/inject-version.mjs",
    "start:study": "ng serve --configuration study",
    "prerelease": "npm run changelog && node scripts/inject-version.mjs",
    "release": "ng build",
    "prebuild:study": "npm run changelog && node scripts/inject-version.mjs",
    "build:study": "ng build --configuration study",
    "postbuild:study": "node scripts/audit-study-build.mjs",
    "audit:study": "node scripts/audit-study-build.mjs",
    "prewatch": "npm run changelog",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "capturas-da-ajuda": "node scripts/capturas-da-ajuda/capturar.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/service-worker": "^22.2.2",
    "@fontsource/pt-sans": "^5.3.0",
    "@luisricar-do/agent": "*",
    "@luisricar-do/antlr": "*",
    "@luisricar-do/parser": "*",
    "@luisricar-do/resources": "*",
    "@luisricar-do/runner": "*",
    "@luisricar-do/runtime": "*",
    "@luisricar-do/worker": "*",
    "@materia-ui/ngx-monaco-editor": "^6.0.0",
    "@mdi/svg": "^7.4.47",
    "@ngxpert/hot-toast": "^7.0.0",
    "angular-split": "^20.0.0",
    "angular-svg-icon": "^19.1.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "marked": "^18.1.0",
    "mermaid": "^12.1.0",
    "monaco-editor": "^0.57.0",
    "ngx-google-analytics": "^14.0.1",
    "ngx-markdown": "^22.1.0",
    "ngx-webstorage": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/file-saver": "^2.0.7",
    "playwright-core": "^1.64.0",
    "typescript": "~6.0.3"
  }
}
